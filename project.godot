; Engine configuration file.
config_version=5

[application]

boot_splash/bg_color=Color(0.106, 0.075, 0.047, 1)
boot_splash/stretch_mode=4
boot_splash/image="res://assets/ui/arranque.png"

config/name="Rise of Ages"
config/description="Estrategia en tiempo real: civilizaciones mesoamericanas."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Setup="*res://scripts/core/setup.gd"
Account="*res://scripts/net/account.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[physics]

common/physics_ticks_per_second=20

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
